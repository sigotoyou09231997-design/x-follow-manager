{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/../scripts/cowork-hook-start.sh\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/../scripts/cowork-hook-stop.sh\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git fetch:*)",
      "Bash(git pull --rebase:*)",
      "Bash(git rev-list:*)",
      "Bash(git status:*)",
      "Bash(bash ../scripts/cowork-watch.sh:*)"
    ]
  }
}