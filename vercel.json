{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/generatePosts.ts": {
      "maxDuration": 60
    },
    "api/publishDue.ts": {
      "maxDuration": 60
    }
  }
}
