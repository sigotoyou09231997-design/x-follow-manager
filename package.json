    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/jszip": "^3.4.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.10.2",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/ui": "^4.1.10",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "jszip": "^3.10.1",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
