{
  "name": "x-follow-manager",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:artifact": "vite build --config vite.artifact.config.ts && node scripts/build-artifact-template.mjs",
