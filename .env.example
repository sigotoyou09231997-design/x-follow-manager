# ブラウザ側（VITE_ が付くものはビルド時にJSへ埋め込まれる＝公開情報）
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx

# サーバー側（Vercelの環境変数にのみ設定する。絶対にVITE_を付けない）
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
X_CLIENT_ID=xxxxxxxxxxxx
X_CLIENT_SECRET=xxxxxxxxxxxx
# pg_cron から publishDue を呼ぶときの合言葉。ランダムな長い文字列にする
CRON_SECRET=xxxxxxxxxxxx
