# すべてサーバー側の環境変数（Vercelに設定する）。
# 接続情報は実行時に /api/config 経由でブラウザへ配るため、VITE_ 系は不要。

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
X_CLIENT_ID=xxxxxxxxxxxx
X_CLIENT_SECRET=xxxxxxxxxxxx
# pg_cron から publishDue を呼ぶときの合言葉。ランダムな長い文字列にする
CRON_SECRET=xxxxxxxxxxxx

# --- アップデート通知（Web Push）用。未設定なら通知機能だけが無効になる ---
# `npx web-push generate-vapid-keys` で発行した鍵を貼る
VAPID_PUBLIC_KEY=Bxxxxxxxxxxxx
VAPID_PRIVATE_KEY=xxxxxxxxxxxx
# 送信元の連絡先。mailto: 付きの自分のメールアドレス
VAPID_SUBJECT=mailto:you@example.com
